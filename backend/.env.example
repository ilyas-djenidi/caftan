# ─── Server ───────────────────────────────────────────────
NODE_ENV=production
PORT=4000
# Public-facing origin (used in image URLs returned to clients)
BASE_URL=https://api.yourdomain.com

# ─── PostgreSQL ───────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=caftan_db
DB_USER=caftan_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_STATEMENT_TIMEOUT=15000

# ─── Redis ────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Default TTL in seconds for cached responses
CACHE_TTL=300

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_AT_LEAST_64_CHARS_RANDOM_STRING
JWT_EXPIRES_IN=7d

# ─── Admin Seed (used by seed-admin script only) ──────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ADMIN_NAME=Admin

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated allowed origins
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ─── Guepex Delivery API ──────────────────────────────────
GUEPEX_API_ID=59135292425582423227
GUEPEX_API_TOKEN=GUEPEX_TOKEN_HERE
GUEPEX_BASE_URL=https://api.guepex.app

# ─── Store Info ───────────────────────────────────────────
STORE_WILAYA=M'Sila
STORE_COMMUNE=Berhoum
STORE_WILAYA_ID=28
STORE_COMMUNE_ID=2810

# ─── n8n Webhook (order notifications) ───────────────────
N8N_WEBHOOK_URL=https://innovation-team.hawiyat.org/webhook/COFTAN

# ─── Cloudinary ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Upload Limits ────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_WEBP_QUALITY=82
UPLOAD_MAX_WIDTH=1920

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_ADMIN_MAX=500
